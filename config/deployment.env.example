# 复制到 /root/.config/wifi-fail2ban/deployment.env。
# 文件必须属于 root:root，权限为 600。不要在仓库中保存真实服务器信息。
# 值不使用 shell 引号，脚本会按纯文本安全解析，不会 source 此文件。

# 以空格分隔的可信 IP 或 CIDR。留空时只忽略本机回环地址。
MANUAL_IPS=203.0.113.10/32 2001:db8::10/128

# FRP 连接次数不能证明后端 SSH/RDP 认证失败，默认关闭。
# 只有明确需要按正常连接次数封禁时才设为 1；旧 auto 值也按关闭处理。
# 此功能会封禁来源的全部端口，并可能触发 recidive；先核对管理白名单。
ENABLE_FRPS=0
# 仅在 ENABLE_FRPS=1 时生效，均为正整数；时间单位为秒。
FRPS_FINDTIME=600
FRPS_MAXRETRY=3
FRPS_BANTIME=86400

# Vaultwarden：auto 存在服务时启用；1 强制启用；0 禁用。
ENABLE_VAULTWARDEN=auto

# 默认日志路径。
FRPS_LOG=/home/Wi-Fi/frps/logs/frps.log
VW_LOG=/home/Wi-Fi/Bitwarden/data/log/vaultwarden.log

# 默认凭据路径。
CREDENTIAL_FILE=/root/.config/wifi-fail2ban/cloudflare.credentials

# Token 模式必须设置每台服务器稳定、唯一的规则来源标记。
# 仅允许字母、数字、点、下划线、连字符，最多 64 字符；旧 Key 模式可留空。
CF_RULE_OWNER=
